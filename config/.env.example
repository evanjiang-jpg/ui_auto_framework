# ==============================================================
# 敏感配置 & CI 变量 —— 复制为 config/.env 后填写真实值
# 本文件（.env）不提交到 Git；CI 平台请在「加密环境变量」中配置同名变量
# ==============================================================

# ---------- 运行环境 ----------
# 不传 -e 时生效，优先级低于命令行 -e
ENV=test

# ---------- 数据库密码（按环境注入，配置文件中一律留空） ----------
DB_PASSWORD=
PROD_DB_PASSWORD=

# ---------- 通用账号密码（生产/预发布走环境变量，不写配置文件） ----------
PROD_COMMON_PWD=
STAGING_COMMON_PWD=

# ---------- 邮件通知（SMTP） ----------
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SSL=true
EMAIL_USER=auto_test@example.com
EMAIL_PASSWORD=            # QQ/企业邮箱填授权码，不是登录密码
EMAIL_SENDER=auto_test@example.com
EMAIL_RECEIVERS=tester1@example.com,tester2@example.com
EMAIL_CC=leader@example.com

# ---------- 钉钉群机器人 ----------
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=           # 安全设置选「加签」时必填
DINGTALK_AT_MOBILES=       # @指定人，逗号分隔
DINGTALK_AT_ALL=false

# ---------- 通知模板自定义目录（可选） ----------
# NOTIFY_TEMPLATE_DIR=./templates/notify

# ---------- CI 变量（CI 平台自动注入，本地可忽略） ----------
CI_PIPELINE_ID=
CI_COMMIT_AUTHOR=
CI_COMMIT_MSG=
CI_BUILD_URL=
