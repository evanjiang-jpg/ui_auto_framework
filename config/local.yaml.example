# ==============================================================
# 本地个人覆盖层（示例文件，不提交到 Git）
# 用法：复制为 config/local.yaml，只覆盖你想在本机改的字段
# 优先级最高：会覆盖 default 层和环境层的同名字段
# ==============================================================

# 比如本机想开着浏览器看执行过程：
# headless: false
# use_stub_browser: false

# 比如本机连自己起的调试服务：
# base_url: http://127.0.0.1:8080
# api_base_url: http://127.0.0.1:8080
